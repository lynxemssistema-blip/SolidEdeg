*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
[Pp]ublish/

# Temporary files
*~
*.tmp
*.temp
*.cache
*.bak
*.orig

# JetBrains
.idea/
*.sln.iml

# Crash dumps
*.dmp
